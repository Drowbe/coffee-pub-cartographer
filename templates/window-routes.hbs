{{! The map's routes and journeys, and its travel setup. Built by window-routes.js; styled in tool-parallax.css. }}

{{! The chevron that opens a card, first in its title row as on the scene-motion window's cards. }}
{{#*inline "expander"}}
<button type="button" class="cartographer-parallax-button cartographer-parallax-collapse" data-action="path-expand"
    {{#if (eq kind "journeyId")}}data-journey-id="{{id}}"{{else}}data-route-id="{{id}}"{{/if}}
    data-tooltip="{{#if expanded}}{{localize "coffee-pub-cartographer.parallax.collapse"}}{{else}}{{localize "coffee-pub-cartographer.parallax.expand"}}{{/if}}"><i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></button>
{{/inline}}

{{! A route's or journey's pace, for the GM. Running it is the bar's job; the clock is the map's, on the Setup tab. }}
{{#*inline "pathControls"}}
<div class="cartographer-routes-terrain-all" data-tooltip="{{localize "coffee-pub-cartographer.routes.journeyPaceHint"}}">
    <span>{{localize "coffee-pub-cartographer.routes.journeyPace"}}</span>
    <span class="cartographer-routes-controls">
        <select data-field="pathPace" {{#if (eq kind "journeyId")}}data-journey-id="{{id}}"{{else}}data-route-id="{{id}}"{{/if}}>
            {{#each controls.paces}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <button type="button" class="cartographer-parallax-button" data-action="path-reset" {{#if (eq kind "journeyId")}}data-journey-id="{{id}}"{{else}}data-route-id="{{id}}"{{/if}}
            data-tooltip="{{localize "coffee-pub-cartographer.routes.resetJourney"}}"><i class="fa-solid fa-backward-fast"></i></button>
    </span>
</div>
<div class="cartographer-routes-terrain-all" data-tooltip="{{localize "coffee-pub-cartographer.routes.directionHint"}}">
    <span>{{localize "coffee-pub-cartographer.routes.direction"}}</span>
    <div class="cartographer-parallax-segmented" role="radiogroup">
        <button type="button" class="cartographer-parallax-segment{{#unless controls.reversed}} is-active{{/unless}}" data-action="path-direction" data-reversed="false"
            {{#if (eq kind "journeyId")}}data-journey-id="{{id}}"{{else}}data-route-id="{{id}}"{{/if}}>{{localize "coffee-pub-cartographer.routes.asDrawn"}}</button>
        <button type="button" class="cartographer-parallax-segment{{#if controls.reversed}} is-active{{/if}}" data-action="path-direction" data-reversed="true"
            {{#if (eq kind "journeyId")}}data-journey-id="{{id}}"{{else}}data-route-id="{{id}}"{{/if}}>{{localize "coffee-pub-cartographer.routes.reversed"}}</button>
    </div>
</div>
{{#if controls.drivenBy}}<p class="cartographer-parallax-hint">{{controls.drivenBy}}</p>{{/if}}
{{/inline}}

{{! How far the party has come along a route or journey. }}
{{#*inline "pathProgress"}}
<p class="cartographer-parallax-hint cartographer-routes-progress">
    <span><i class="fa-solid fa-person-walking"></i> <span {{#if (eq kind "journeyId")}}data-progress-journey="{{id}}"{{else}}data-progress-route="{{id}}"{{/if}}>{{progressText}}</span></span>
</p>
{{/inline}}

<nav class="cartographer-parallax-tabs" role="tablist">
    {{#each tabs}}
    <button type="button" role="tab" class="cartographer-parallax-tab{{#if active}} is-active{{/if}}" data-action="routes-tab" data-tab="{{id}}" aria-selected="{{active}}">
        <i class="{{icon}}"></i><span>{{label}}</span>{{#if count}}<span class="cartographer-parallax-tab-count">{{count}}</span>{{/if}}
    </button>
    {{/each}}
</nav>
<div class="cartographer-parallax-panel cartographer-routes-panel">
    {{#unless hasGrid}}
    <p class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.routes.noGrid"}}</p>
    {{else}}

    {{#if drawing}}
    <p class="cartographer-parallax-hint cartographer-routes-drawing">{{localize "coffee-pub-cartographer.routes.drawHint"}}</p>
    {{/if}}
    {{#unless showing}}
    <p class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.routes.turnedOff"}}</p>
    {{/unless}}

    {{#if isSetup}}
    {{! The map's travel setup: the same for every route and journey on it. }}
    <div class="cartographer-parallax-measures">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.measureGrid"}}</span><div class="cartographer-parallax-measure">{{gridText}}</div>
        {{#if paceGroups.length}}
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.routes.timesAt"}}</span>
        <div class="cartographer-parallax-measure">
            <select class="cartographer-routes-pace" data-field="routePace" data-tooltip="{{localize "coffee-pub-cartographer.routes.paceHint"}}">
                {{#each paceGroups}}
                <optgroup label="{{label}}">{{#each paces}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
                {{/each}}
            </select>
        </div>
        {{/if}}
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.routes.travelDay"}}</span>
        <div class="cartographer-parallax-measure">
            {{#if canPlan}}
            <input type="number" class="cartographer-routes-hours" data-field="hoursPerDay" value="{{hoursPerDay}}" min="1" max="24" step="0.5"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.travelDayHint"}}"> {{localize "coffee-pub-cartographer.routes.hoursADay"}}
            {{else}}
            {{hoursPerDay}} {{localize "coffee-pub-cartographer.routes.hoursADay"}}
            {{/if}}
        </div>
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.travelFollowClock"}}</span>
        <div class="cartographer-parallax-measure cartographer-routes-marker" data-tooltip="{{localize "coffee-pub-cartographer.routes.followClockHint"}}">
            {{#if canPlan}}
            <button type="button" class="cartographer-parallax-switch{{#if followClock}} is-on{{/if}}" role="switch" aria-checked="{{#if followClock}}true{{else}}false{{/if}}"
                data-action="map-clock"><span class="cartographer-parallax-switch-knob"></span></button>
            {{/if}}
            <span>{{#if followClock}}{{localize "coffee-pub-cartographer.routes.clockOn"}}{{else}}{{localize "coffee-pub-cartographer.routes.clockOff"}}{{/if}}</span>
        </div>
        {{! The party's marker on this map, for the GM: shown to players, and its look in Blacksmith's Configure Pin. }}
        {{#if marker}}
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.routes.partyMarkerLabel"}}</span>
        <div class="cartographer-parallax-measure cartographer-routes-marker">
            {{#if marker.removed}}
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="marker-add" {{#unless marker.canAdd}}disabled{{/unless}}
                data-tooltip="{{#if marker.canAdd}}{{localize "coffee-pub-cartographer.routes.markerAddHint"}}{{else}}{{localize "coffee-pub-cartographer.routes.markerNothingToFollow"}}{{/if}}"><i class="fa-solid fa-plus"></i><span>{{localize "coffee-pub-cartographer.routes.markerAdd"}}</span></button>
            <span>{{localize "coffee-pub-cartographer.routes.markerRemoved"}}</span>
            {{else}}
            {{#if marker.exists}}
            <button type="button" class="cartographer-parallax-switch{{#if marker.shown}} is-on{{/if}}" role="switch" aria-checked="{{#if marker.shown}}true{{else}}false{{/if}}"
                data-action="marker-shown" data-tooltip="{{localize "coffee-pub-cartographer.routes.markerShownHint"}}"><span class="cartographer-parallax-switch-knob"></span></button>
            <span>{{localize "coffee-pub-cartographer.routes.markerToPlayers"}}</span>
            {{/if}}
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="marker-configure" {{#unless marker.canConfigure}}disabled{{/unless}}
                data-tooltip="{{#if marker.canConfigure}}{{localize "coffee-pub-cartographer.routes.markerConfigureHint"}}{{else}}{{localize "coffee-pub-cartographer.routes.markerNothingToFollow"}}{{/if}}"><i class="fa-solid fa-palette"></i><span>{{localize "coffee-pub-cartographer.routes.markerConfigure"}}</span></button>
            {{/if}}
        </div>
        {{/if}}
    </div>
    {{#if dayWarning}}<p class="cartographer-parallax-hint cartographer-routes-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{dayWarning}}</p>{{/if}}
    {{/if}}

    {{#if isRoutes}}
    {{#if partyOffRoute}}
    <p class="cartographer-parallax-hint cartographer-routes-warning"><i class="fa-solid fa-location-dot"></i> {{localize "coffee-pub-cartographer.routes.partyOffRouteHint"}}</p>
    {{/if}}
    <div class="cartographer-parallax-panel-actions">
        {{#if partyOffRoute}}
        <button type="button" class="cartographer-parallax-button is-labelled" data-action="route-draw-from-party"
            data-tooltip="{{localize "coffee-pub-cartographer.routes.drawFromPartyHint"}}"><i class="fa-solid fa-person-walking-arrow-right"></i><span>{{localize "coffee-pub-cartographer.routes.drawFromParty"}}</span></button>
        {{/if}}
        <button type="button" class="cartographer-parallax-button is-labelled{{#if drawing}} is-active{{/if}}" data-action="route-draw"
            data-tooltip="{{localize "coffee-pub-cartographer.routes.drawHint"}}"><i class="fa-solid {{#if drawing}}fa-check{{else}}fa-route{{/if}}"></i><span>{{#if drawing}}{{localize "coffee-pub-cartographer.routes.finishDrawing"}}{{else}}{{localize "coffee-pub-cartographer.routes.draw"}}{{/if}}</span></button>
    </div>
    {{#each routes}}
    <div class="cartographer-routes-route{{#if hidden}} is-hidden{{/if}}{{#if editing}} is-editing{{/if}}{{#if (eq id @root.barRouteId)}} is-selected{{/if}}">
        <div class="cartographer-routes-head">
            {{> expander kind="routeId"}}
            {{#if canEdit}}
            <input type="color" class="cartographer-routes-swatch" value="{{color}}" data-field="routeColor" data-route-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.color"}}" aria-label="{{localize "coffee-pub-cartographer.routes.color"}}">
            {{else}}
            <span class="cartographer-routes-swatch" style="background: {{color}}"></span>
            {{/if}}
            <span class="cartographer-routes-name">{{name}}{{#if maker}} <span class="cartographer-routes-maker">{{maker}}</span>{{/if}}</span>
            <strong class="cartographer-routes-length">{{length}}</strong>
            <button type="button" class="cartographer-parallax-button" data-action="route-focus" data-route-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.focus"}}"><i class="fa-solid fa-crosshairs"></i></button>
            {{#if canEdit}}
            <button type="button" class="cartographer-parallax-button" data-action="route-hide" data-route-id="{{id}}"
                data-tooltip="{{#if hidden}}{{localize "coffee-pub-cartographer.routes.showRoute"}}{{else}}{{localize "coffee-pub-cartographer.routes.hideRoute"}}{{/if}}"><i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
            <button type="button" class="cartographer-parallax-button{{#if editing}} is-active{{/if}}" data-action="route-edit" data-route-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.editWaypoints"}}"><i class="fa-solid fa-bezier-curve"></i></button>
            <button type="button" class="cartographer-parallax-button" data-action="route-rename" data-route-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.rename"}}"><i class="fa-solid fa-pen"></i></button>
            <button type="button" class="cartographer-parallax-button is-danger" data-action="route-remove" data-route-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.remove"}}"><i class="fa-solid fa-trash"></i></button>
            {{/if}}
        </div>
        {{#if editing}}
        <p class="cartographer-parallax-hint cartographer-routes-drawing">{{localize "coffee-pub-cartographer.routes.editHint"}}</p>
        {{/if}}
        {{#if progressText}}{{> pathProgress kind="routeId"}}{{/if}}
        <div class="cartographer-routes-meta">
            <span>{{legsText}}{{#if difficult}} · {{localize "coffee-pub-cartographer.routes.someDifficult"}}{{/if}}</span>
            {{#if timeText}}<span>{{timeText}}</span>{{/if}}
        </div>
        {{#if expanded}}
        {{#if controls}}{{> pathControls kind="routeId"}}{{/if}}
        {{#if canEdit}}
        <label class="cartographer-routes-terrain-all">
            <span>{{localize "coffee-pub-cartographer.routes.terrainAll"}}</span>
            <select data-field="routeTerrain" data-route-id="{{id}}">
                {{#each allTerrain}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
        </label>
        {{/if}}
        <ol class="cartographer-routes-legs">
            {{#each legs}}
            <li>
                <span>{{localize "coffee-pub-cartographer.routes.leg"}} {{number}}</span>
                <span>{{length}}</span>
                {{#if ../canEdit}}
                <select data-field="legTerrain" data-route-id="{{../id}}" data-leg="{{index}}">
                    {{#each terrain}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                {{else}}
                <span>{{terrainName}}</span>
                {{/if}}
            </li>
            {{/each}}
        </ol>
        {{/if}}
    </div>
    {{else}}
    <p class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.routes.empty"}}</p>
    {{/each}}
    {{/if}}

    {{#if isJourneys}}
    {{! Journeys: routes in order, joined end to end. }}
    <div class="cartographer-parallax-panel-actions">
        <button type="button" class="cartographer-parallax-button is-labelled" data-action="journey-new"
            data-tooltip="{{localize "coffee-pub-cartographer.routes.journeyHint"}}"><i class="fa-solid fa-plus"></i><span>{{localize "coffee-pub-cartographer.routes.newJourney"}}</span></button>
    </div>
    {{#each journeys}}
    <div class="cartographer-routes-route{{#if (eq id @root.barJourneyId)}} is-selected{{/if}}">
        <div class="cartographer-routes-head">
            {{> expander kind="journeyId"}}
            <i class="fa-solid fa-map-signs"></i>
            <span class="cartographer-routes-name">{{name}}</span>
            <strong class="cartographer-routes-length">{{length}}</strong>
            <button type="button" class="cartographer-parallax-button" data-action="journey-focus" data-journey-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.focus"}}"><i class="fa-solid fa-crosshairs"></i></button>
            {{#if canEdit}}
            <button type="button" class="cartographer-parallax-button" data-action="journey-rename" data-journey-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.renameJourney"}}"><i class="fa-solid fa-pen"></i></button>
            <button type="button" class="cartographer-parallax-button is-danger" data-action="journey-remove" data-journey-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.routes.removeJourney"}}"><i class="fa-solid fa-trash"></i></button>
            {{/if}}
        </div>
        {{#if progressText}}{{> pathProgress kind="journeyId"}}{{/if}}
        <div class="cartographer-routes-meta">
            <span>{{routeCountText}}{{#if gapText}} · <i class="fa-solid fa-triangle-exclamation"></i> {{gapText}}{{/if}}</span>
            {{#if timeText}}<span>{{timeText}}</span>{{/if}}
        </div>
        {{#if expanded}}
        {{#if controls}}{{> pathControls kind="journeyId"}}{{/if}}
        <ol class="cartographer-routes-legs">
            {{#each routes}}
            <li{{#if gapAfter}} class="has-gap"{{/if}}>
                <span><span class="cartographer-routes-swatch" style="background: {{color}}"></span> {{number}}. {{name}}</span>
                <span>{{length}}</span>
                {{#if ../canEdit}}
                <span class="cartographer-routes-order">
                    <button type="button" class="cartographer-parallax-button" data-action="journey-move" data-journey-id="{{../id}}" data-index="{{index}}" data-by="-1"
                        {{#if isFirst}}disabled{{/if}} data-tooltip="{{localize "coffee-pub-cartographer.routes.moveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>
                    <button type="button" class="cartographer-parallax-button" data-action="journey-move" data-journey-id="{{../id}}" data-index="{{index}}" data-by="1"
                        {{#if isLast}}disabled{{/if}} data-tooltip="{{localize "coffee-pub-cartographer.routes.moveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>
                    <button type="button" class="cartographer-parallax-button is-danger" data-action="journey-drop" data-journey-id="{{../id}}" data-index="{{index}}"
                        data-tooltip="{{localize "coffee-pub-cartographer.routes.dropFromJourney"}}"><i class="fa-solid fa-xmark"></i></button>
                </span>
                {{/if}}
            </li>
            {{else}}
            <li class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.routes.journeyEmpty"}}</li>
            {{/each}}
        </ol>
        {{#if canEdit}}
        <select class="cartographer-routes-add" data-field="journeyAdd" data-journey-id="{{id}}">
            <option value="">{{localize "coffee-pub-cartographer.routes.addToJourney"}}</option>
            {{#each addable}}<option value="{{id}}">{{name}}</option>{{/each}}
        </select>
        {{/if}}
        {{/if}}
    </div>
    {{else}}
    <p class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.routes.noJourneys"}}</p>
    {{/each}}
    {{/if}}
    {{/unless}}
</div>
