{{! The list follows the shape of the other tool windows -- a section per group,
    a row per map -- but is styled from the --blacksmith-tool-* variables the
    tool window API publishes, which is the part of it that adapts to the theme.
    Blacksmith's blacksmith-list-* and blacksmith-window-section components are
    for its dark window family and hard-code their colours; on this window's
    paper they render near-white text on cream. Overriding a component's colours
    would be fighting it, so they are not used. }}
<div class="cartographer-mapping-root{{#if isListView}} is-list-view{{/if}}{{gridClass}}">
    {{#if isListView}}
    <div class="cartographer-mapping-list">
        {{! Making a map. One card per kind, each shown only while the thing it
            would make does not exist yet. }}
        {{#if showAnyCreateCard}}
        <div class="cartographer-mapping-section">
            <div class="cartographer-mapping-section-header">
                <i class="fa-solid fa-plus"></i>
                <span>{{createSectionLabel}}</span>
            </div>
            <div class="cartographer-mapping-section-body">
                {{#if showCreateCard}}
                <div class="cartographer-mapping-row cartographer-mapping-create" data-action="add-map" role="button" tabindex="0">
                    <i class="fa-solid fa-user-pen cartographer-mapping-row-img cartographer-mapping-row-glyph"></i>
                    <div class="cartographer-mapping-row-main">
                        <div class="cartographer-mapping-row-title">{{createTitle}}</div>
                        <div class="cartographer-mapping-row-meta">{{createHint}}</div>
                    </div>
                </div>
                {{/if}}
                {{#if showPartyCard}}
                <div class="cartographer-mapping-row cartographer-mapping-create" data-action="add-party-map" role="button" tabindex="0">
                    <i class="fa-solid fa-users cartographer-mapping-row-img cartographer-mapping-row-glyph"></i>
                    <div class="cartographer-mapping-row-main">
                        <div class="cartographer-mapping-row-title">{{partyTitle}}</div>
                        <div class="cartographer-mapping-row-meta">{{partyHint}}</div>
                    </div>
                </div>
                {{/if}}
                {{#if showOfficialCard}}
                <div class="cartographer-mapping-row cartographer-mapping-create" data-action="add-official-map" role="button" tabindex="0">
                    <i class="fa-solid fa-scroll cartographer-mapping-row-img cartographer-mapping-row-glyph"></i>
                    <div class="cartographer-mapping-row-main">
                        <div class="cartographer-mapping-row-title">{{officialTitle}}</div>
                        <div class="cartographer-mapping-row-meta">{{officialHint}}</div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
        {{/if}}

        {{#if listEmpty}}
        <div class="cartographer-mapping-empty-list">{{listEmptyMessage}}</div>
        {{else}}
        {{! One section per group, carrying whichever of scene or character the
            group is keyed on, so each row only has to say the other. }}
        {{#each groups}}
        <div class="cartographer-mapping-section{{#if isHere}} cartographer-mapping-here{{/if}}">
            <div class="cartographer-mapping-section-header">
                <i class="fa-solid {{#if isHere}}fa-location-dot{{else}}fa-folder{{/if}}"></i>
                <span>{{name}}</span>
                <span class="cartographer-mapping-section-count">{{count}}</span>
            </div>
            <div class="cartographer-mapping-section-body">
                {{#each maps}}
                <div class="cartographer-mapping-row{{#if isCurrent}} is-active{{/if}}" data-action="select-map" data-map-id="{{id}}" role="button" tabindex="0">
                    {{#if thumbnail}}
                    <img class="cartographer-mapping-row-img cartographer-mapping-thumb" src="{{thumbnail}}" alt="" draggable="false">
                    {{else}}
                    <i class="fa-solid fa-map cartographer-mapping-row-img cartographer-mapping-row-glyph"></i>
                    {{/if}}
                    <div class="cartographer-mapping-row-main">
                        <div class="cartographer-mapping-row-title">
                            {{#if isOfficial}}<i class="fa-solid fa-star cartographer-mapping-official-star" data-tooltip="{{kindLabel}}"></i> {{/if}}{{name}}
                        </div>
                        {{#if subtitle}}<div class="cartographer-mapping-row-meta">{{subtitle}}</div>{{/if}}
                        <div class="cartographer-mapping-row-meta">{{feetMapped}} {{../../feetMappedLabel}}{{#if updated}} · {{updated}}{{/if}}</div>
                    </div>
                    {{#if canManage}}
                    <div class="cartographer-mapping-row-actions">
                        {{! Hand what this map knows to the party's. Adds only, so
                            it can be pressed again after exploring further. }}
                        {{#if canDonate}}
                        <button type="button" class="cartographer-mapping-action" data-action="donate-map" data-map-id="{{id}}" data-tooltip="{{../../donateLabel}}" aria-label="{{../../donateLabel}}">
                            <i class="fa-solid fa-hand-holding-heart"></i>
                        </button>
                        {{/if}}
                        {{! Whether anyone else sees this map at all. }}
                        {{#if canShare}}
                        <button type="button" class="cartographer-mapping-action cartographer-mapping-share{{#if isShared}} is-shared{{/if}}" data-action="toggle-shared" data-map-id="{{id}}" data-shared="{{isShared}}" data-tooltip="{{shareLabel}}" aria-label="{{shareLabel}}" aria-pressed="{{isShared}}">
                            <i class="fa-solid {{#if isShared}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                        </button>
                        {{/if}}
                        <button type="button" class="cartographer-mapping-action" data-action="rename-map" data-map-id="{{id}}" data-tooltip="{{../../renameLabel}}" aria-label="{{../../renameLabel}}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        {{#if canDelete}}
                        <button type="button" class="cartographer-mapping-action is-critical" data-action="delete-map" data-map-id="{{id}}" data-tooltip="{{../../deleteLabel}}" aria-label="{{../../deleteLabel}}">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>
        {{/each}}
        {{/if}}
    </div>
    {{else}}
    <div class="cartographer-mapping-viewport">
        {{#if isRecording}}
        {{! Stays visible while the bars are hidden, so it is always obvious
            that movement is being recorded. }}
        <span class="cartographer-mapping-rec{{#if isPaused}} is-paused{{/if}}" aria-hidden="true"></span>
        {{! The marker arrives at the stop square as soon as the token does. This
            says the linework for the route is still being drawn, so an area
            that has not filled in yet reads as pending rather than missed.
            Shown by toggling is-mapping on the viewport. }}
        <span class="cartographer-mapping-drawing" aria-hidden="true">
            <i class="fa-solid fa-compass-drafting fa-spin"></i>
            <span>{{drawingLabel}}</span>
        </span>
        {{/if}}
        {{#if empty}}
        <div class="cartographer-mapping-empty">
            <i class="fa-solid fa-map"></i>
            <span>{{emptyMessage}}</span>
        </div>
        {{else}}
        <div class="cartographer-mapping-grid" data-origin-column="{{originColumn}}" data-origin-row="{{originRow}}" style="--cartographer-map-columns: {{columnCount}}; --cartographer-map-rows: {{rowCount}};">
            {{! Solid rock around the mapped area. Drawn before the floor cells
                so nothing can sit on top of a room. }}
            {{#each hatchCells}}
            <div class="cartographer-mapping-hatch is-ring-{{ring}}" data-cell="{{key}}" style="grid-column: {{gridColumn}}; grid-row: {{gridRow}}; --cartographer-hatch-x: {{patternX}}; --cartographer-hatch-y: {{patternY}};" aria-hidden="true"></div>
            {{/each}}
            {{! Floor surfaces: one layer per surface for the whole map, not one
                masked box per square, which is what made any surface but Default
                crawl. Each layer tiles its pattern once across the grid and is
                cut to the squares carrying it -- whole squares as rectangles,
                run-merged along each row, and the squares a wall cuts through as
                the polygon that wall left. Ordered by z-index rather than by
                markup: above the paper, below the linework. }}
            {{#if floorLayers}}
            <svg class="cartographer-mapping-floor-clips" aria-hidden="true" focusable="false">
                <defs>
                    {{#each floorLayers}}
                    <clipPath id="{{clipId}}" clipPathUnits="objectBoundingBox">
                        {{#each rects}}<rect x="{{x}}" y="{{y}}" width="{{width}}" height="{{height}}"></rect>{{/each}}
                        {{#each polygons}}<polygon points="{{this}}"></polygon>{{/each}}
                    </clipPath>
                    {{/each}}
                </defs>
            </svg>
            {{#each floorLayers}}
            <div class="cartographer-mapping-floor is-floor-{{type}}" style="clip-path: url(#{{clipId}}); --cartographer-floor-x: {{patternX}}; --cartographer-floor-y: {{patternY}};" aria-hidden="true"></div>
            {{/each}}
            {{/if}}
            {{#each cells}}
            <div class="cartographer-mapping-cell {{className}}" data-cell="{{key}}" style="grid-column: {{gridColumn}}; grid-row: {{gridRow}};{{#if floorClip}} --cartographer-floor-clip: polygon({{floorClip}});{{/if}}">
                {{#if hasLinework}}
                <svg class="cartographer-mapping-segments" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    {{#each segments}}
                    <polyline class="cartographer-mapping-segment {{className}} is-sketch-echo" points="{{echoPoints}}"></polyline>
                    <polyline class="cartographer-mapping-segment {{className}}" points="{{points}}"></polyline>
                    {{/each}}
                    {{#each doorSymbols}}
                    <g class="cartographer-mapping-door-symbol" transform="{{transform}}" data-tooltip="{{label}}">
                        {{#each lines}}
                        <polyline class="cartographer-mapping-door-line is-sketch-echo" points="{{echoPoints}}"></polyline>
                        <polyline class="cartographer-mapping-door-line" points="{{points}}"></polyline>
                        {{/each}}
                        <polygon class="cartographer-mapping-door-box is-sketch-echo" points="{{echoBoxPoints}}"></polygon>
                        <polygon class="cartographer-mapping-door-box" points="{{boxPoints}}"></polygon>
                        {{#if mark}}
                        <g class="cartographer-mapping-door-mark">
                            {{#each mark.lines}}
                            <polyline class="cartographer-mapping-door-line is-sketch-echo" points="{{echoPoints}}"></polyline>
                            <polyline class="cartographer-mapping-door-line" points="{{points}}"></polyline>
                            {{/each}}
                        </g>
                        {{/if}}
                    </g>
                    {{/each}}
                    {{#each windowSymbols}}
                    <g class="cartographer-mapping-window-symbol" transform="{{transform}}" data-tooltip="{{label}}">
                        {{#each lines}}
                        <polyline class="cartographer-mapping-window-line is-sketch-echo" points="{{echoPoints}}"></polyline>
                        <polyline class="cartographer-mapping-window-line" points="{{points}}"></polyline>
                        {{/each}}
                        <polygon class="cartographer-mapping-window-slot is-sketch-echo" points="{{echoSlotPoints}}"></polygon>
                        <polygon class="cartographer-mapping-window-slot" points="{{slotPoints}}"></polygon>
                    </g>
                    {{/each}}
                    {{#each secretDoorSymbols}}
                    <g class="cartographer-mapping-secret-door-symbol" transform="{{transform}}" data-tooltip="{{label}}">
                        {{#each lines}}
                        <polyline class="cartographer-mapping-secret-door-line is-sketch-echo" points="{{echoPoints}}"></polyline>
                        <polyline class="cartographer-mapping-secret-door-line" points="{{points}}"></polyline>
                        {{/each}}
                        <text class="cartographer-mapping-secret-door-letter" x="50" y="26">S</text>
                    </g>
                    {{/each}}
                </svg>
                {{/if}}
                {{#if symbol}}
                <svg class="cartographer-mapping-placeable {{symbol.className}}" viewBox="0 0 100 100" role="img" data-tooltip="{{symbol.label}}"{{#if symbol.tooltipClass}} data-tooltip-class="{{symbol.tooltipClass}}"{{/if}} aria-label="{{symbol.label}}">
                    {{{symbol.markup}}}
                </svg>
                {{/if}}
                {{#if isParty}}<i class="fa-solid fa-street-view cartographer-mapping-party" aria-hidden="true"></i>{{/if}}
            </div>
            {{/each}}
        </div>
        {{#if isBlankCanvas}}
        {{! Blank ruled ground has nothing on it to suggest what to do with it,
            and the answer -- right-click a square -- is not guessable. Says so
            once, and goes as soon as the first square is drawn. Never takes the
            pointer: the whole point is that the ground beneath it is clickable. }}
        <div class="cartographer-mapping-canvas-hint" aria-hidden="true">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <span>{{blankCanvasHint}}</span>
        </div>
        {{/if}}
        {{#if showParty}}
        {{! Pinned twin of the party marker. While following, the viewport shows
            this one and hides the in-grid marker, so the party stays exactly at
            the centre and the map slides beneath it. }}
        <i class="fa-solid fa-street-view cartographer-mapping-party is-pinned" aria-hidden="true"></i>
        {{/if}}
        {{/if}}
    </div>
    {{/if}}
</div>
