{{! Styled from the --blacksmith-tool-* variables so it follows Light, Dark and
    Glass. Sliders carry data-field (and data-layer-id or data-tile-id); the
    window previews on input and writes the scene on change.

    This is the settings body only; the control bar is built in the window's
    script. Two modes share it -- parallax layers and tiles -- each with its
    own tabs, and the Sets tab common to both. }}

{{! A layer in setup mode. Collapsed, it is one line: what it is, how fast,
    and the buttons. Expanded, its sliders follow. }}
{{#*inline "layerRow"}}
<div class="cartographer-parallax-layer{{#unless visible}} is-hidden{{/unless}}{{#if overhead}} is-overhead{{/if}}{{#if collapsed}} is-collapsed{{/if}}">
    <div class="cartographer-parallax-layer-header">
        <button type="button" class="cartographer-parallax-button cartographer-parallax-collapse" data-action="toggle-collapse" data-layer-id="{{id}}"
            data-tooltip="{{localize (ifThen collapsed "coffee-pub-cartographer.parallax.expand" "coffee-pub-cartographer.parallax.collapse")}}"><i class="fa-solid {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
        <button type="button" class="cartographer-parallax-thumb" data-action="replace-layer" data-layer-id="{{id}}"
            data-tooltip="{{localize "coffee-pub-cartographer.parallax.replaceImage"}}">
            {{#if isVideo}}<i class="fa-solid fa-film"></i>{{else}}<img src="{{src}}" alt="">{{/if}}
        </button>
        <div class="cartographer-parallax-layer-title">
            <span class="cartographer-parallax-layer-name" data-tooltip="{{src}}">{{name}}{{#each setNames}} <span class="cartographer-parallax-set-badge">{{this}}</span>{{/each}}</span>
            {{#if collapsed}}
            <span class="cartographer-parallax-layer-summary">
                {{speed}} px/s{{#if band}} · {{localize "coffee-pub-cartographer.parallax.band"}}{{/if}}{{#unless visible}} · {{localize "coffee-pub-cartographer.parallax.hidden"}}{{/unless}}
            </span>
            {{/if}}
        </div>
        <div class="cartographer-parallax-layer-actions">
            <button type="button" class="cartographer-parallax-button{{#if visible}} is-active{{/if}}" data-action="toggle-visible" data-layer-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleVisible"}}"><i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
            <button type="button" class="cartographer-parallax-button" data-action="move-up" data-layer-id="{{id}}" {{#if isFirst}}disabled{{/if}}
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.moveNearer"}}"><i class="fa-solid fa-chevron-up"></i></button>
            <button type="button" class="cartographer-parallax-button" data-action="move-down" data-layer-id="{{id}}" {{#if isLast}}disabled{{/if}}
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.moveFarther"}}"><i class="fa-solid fa-chevron-down"></i></button>
            <button type="button" class="cartographer-parallax-button is-danger" data-action="remove-layer" data-layer-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.removeLayer"}}"><i class="fa-solid fa-trash-can"></i></button>
        </div>
    </div>

    {{#unless collapsed}}
    <label class="cartographer-parallax-field">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.speed"}}</span>
        <input type="range" data-field="speed" data-layer-id="{{id}}" value="{{speed}}" list="cartographer-parallax-zero"
            min="{{@root.ranges.speed.min}}" max="{{@root.ranges.speed.max}}" step="{{@root.ranges.speed.step}}">
        <span class="cartographer-parallax-value">{{speed}}</span>
    </label>
    <label class="cartographer-parallax-field">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.opacity"}}</span>
        <input type="range" data-field="alpha" data-layer-id="{{id}}" value="{{alpha}}"
            min="{{@root.ranges.alpha.min}}" max="{{@root.ranges.alpha.max}}" step="{{@root.ranges.alpha.step}}">
        <span class="cartographer-parallax-value">{{alpha}}</span>
    </label>
    <label class="cartographer-parallax-field">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.scale"}}</span>
        <input type="range" data-field="scale" data-layer-id="{{id}}" value="{{scale}}"
            min="{{@root.ranges.scale.min}}" max="{{@root.ranges.scale.max}}" step="{{@root.ranges.scale.step}}">
        <span class="cartographer-parallax-value">{{scale}}</span>
    </label>
    <label class="cartographer-parallax-field" data-tooltip="{{localize "coffee-pub-cartographer.parallax.angleOffsetHint"}}">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.angleOffset"}}</span>
        <input type="range" data-field="angleOffset" data-layer-id="{{id}}" value="{{angleOffset}}" list="cartographer-parallax-zero"
            min="{{@root.ranges.angleOffset.min}}" max="{{@root.ranges.angleOffset.max}}" step="{{@root.ranges.angleOffset.step}}">
        <span class="cartographer-parallax-value">{{angleOffset}}°</span>
    </label>
    <label class="cartographer-parallax-field" data-tooltip="{{localize "coffee-pub-cartographer.parallax.depthHint"}}">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.depth"}}</span>
        <input type="range" data-field="depth" data-layer-id="{{id}}" value="{{depth}}" list="cartographer-parallax-zero"
            min="{{@root.ranges.depth.min}}" max="{{@root.ranges.depth.max}}" step="{{@root.ranges.depth.step}}">
        <span class="cartographer-parallax-value">{{depth}}</span>
    </label>
    <div class="cartographer-parallax-field cartographer-parallax-start" data-tooltip="{{localize "coffee-pub-cartographer.parallax.startHint"}}">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.start"}}</span>
        <div class="cartographer-parallax-xy">
            <label><span>X</span><input type="number" data-field="startX" data-layer-id="{{id}}" value="{{startX}}" step="1"></label>
            <label><span>Y</span><input type="number" data-field="startY" data-layer-id="{{id}}" value="{{startY}}" step="1"></label>
        </div>
    </div>
    {{! Two exclusive answers, so two buttons rather than a checkbox. The band's
        offset sits in the value column, where the sliders show their numbers. }}
    <div class="cartographer-parallax-field cartographer-parallax-repeat">
        <span class="cartographer-parallax-label" data-tooltip="{{localize "coffee-pub-cartographer.parallax.bandHint"}}">{{localize "coffee-pub-cartographer.parallax.repeat"}}</span>
        <div class="cartographer-parallax-segmented" role="radiogroup">
            <button type="button" class="cartographer-parallax-segment{{#unless band}} is-active{{/unless}}" data-action="set-band" data-layer-id="{{id}}" data-band="false"
                role="radio" aria-checked="{{#if band}}false{{else}}true{{/if}}" data-tooltip="{{localize "coffee-pub-cartographer.parallax.tileHint"}}">{{localize "coffee-pub-cartographer.parallax.tile"}}</button>
            <button type="button" class="cartographer-parallax-segment{{#if band}} is-active{{/if}}" data-action="set-band" data-layer-id="{{id}}" data-band="true"
                role="radio" aria-checked="{{#if band}}true{{else}}false{{/if}}" data-tooltip="{{localize "coffee-pub-cartographer.parallax.bandHint"}}">{{localize "coffee-pub-cartographer.parallax.band"}}</button>
        </div>
        {{#if band}}
        <input type="number" class="cartographer-parallax-band-offset" data-field="bandOffset" data-layer-id="{{id}}" value="{{bandOffset}}" step="1"
            aria-label="{{localize "coffee-pub-cartographer.parallax.bandOffset"}}" data-tooltip="{{localize "coffee-pub-cartographer.parallax.bandOffsetHint"}}">
        {{/if}}
    </div>
    {{/unless}}
</div>
{{/inline}}

{{! One of a set's layers, in the Sets tab: on or off within that set. }}
{{#*inline "setMember"}}
<div class="cartographer-parallax-set-member{{#if offInSet}} is-off{{/if}}">
    <span class="cartographer-parallax-set-member-thumb">{{#if isVideo}}<i class="fa-solid fa-film"></i>{{else}}<img src="{{src}}" alt="">{{/if}}</span>
    <span class="cartographer-parallax-layer-name" data-tooltip="{{src}}">{{name}}</span>
    <button type="button" class="cartographer-parallax-button{{#unless offInSet}} is-active{{/unless}}" data-action="toggle-set-layer" data-set-id="{{setId}}" data-layer-id="{{id}}"
        data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleInSet"}}"><i class="fa-solid {{#if offInSet}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
</div>
{{/inline}}

{{#*inline "tokenLine"}}
<div class="cartographer-parallax-token-line" data-tooltip="{{localize "coffee-pub-cartographer.parallax.tokenLineHint"}}">
    <span><i class="fa-solid fa-chess-pawn"></i> {{localize "coffee-pub-cartographer.parallax.tokenLine"}}</span>
</div>
{{/inline}}

{{! One of a set's tiles, in the Sets tab: on or off within that set. }}
{{#*inline "setTileMember"}}
<div class="cartographer-parallax-set-member{{#if offInSet}} is-off{{/if}}">
    <span class="cartographer-parallax-set-member-thumb">{{#if isVideo}}<i class="fa-solid fa-film"></i>{{else}}<img src="{{src}}" alt="">{{/if}}</span>
    <span class="cartographer-parallax-layer-name" data-tooltip="{{src}}"><i class="fa-solid fa-arrows-spin cartographer-parallax-kind"></i> {{name}}</span>
    <button type="button" class="cartographer-parallax-button{{#unless offInSet}} is-active{{/unless}}" data-action="toggle-set-tile" data-set-id="{{setId}}" data-tile-id="{{id}}"
        data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleInSet"}}"><i class="fa-solid {{#if offInSet}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
</div>
{{/inline}}

{{! ===== TILES ===== }}
{{! A slider row for one part of a tile's motion. }}
{{#*inline "tileSlider"}}
<label class="cartographer-parallax-field">
    <span class="cartographer-parallax-label">{{label}}</span>
    <input type="range" data-field="tile" data-tile-id="{{tileId}}" data-path="{{path}}" value="{{value}}"{{#if zero}} list="cartographer-parallax-zero"{{/if}}
        min="{{range.min}}" max="{{range.max}}" step="{{range.step}}">
    <span class="cartographer-parallax-value">{{readout}}</span>
</label>
{{/inline}}

{{! An Off / On pair for one part of a tile's motion. The chosen side is disabled: choosing it again does nothing. }}
{{#*inline "tilePartSwitch"}}
<div class="cartographer-parallax-field cartographer-parallax-repeat">
    <span class="cartographer-parallax-label"><i class="{{icon}}"></i> {{label}}</span>
    <div class="cartographer-parallax-segmented" role="radiogroup">
        <button type="button" class="cartographer-parallax-segment{{#unless enabled}} is-active{{/unless}}" {{#unless enabled}}disabled{{/unless}}
            data-action="toggle-tile-part" data-tile-id="{{tileId}}" data-part="{{part}}">{{localize "coffee-pub-cartographer.parallax.off"}}</button>
        <button type="button" class="cartographer-parallax-segment{{#if enabled}} is-active{{/if}}" {{#if enabled}}disabled{{/if}}
            data-action="toggle-tile-part" data-tile-id="{{tileId}}" data-part="{{part}}">{{localize "coffee-pub-cartographer.parallax.on"}}</button>
    </div>
</div>
{{/inline}}

{{! A managed tile in the Tiles tab. Collapsed, it is one line; expanded, its settings follow, as a layer's do. }}
{{#*inline "tileRow"}}
<div class="cartographer-parallax-layer{{#unless visible}} is-hidden{{/unless}}{{#if collapsed}} is-collapsed{{/if}}{{#if selected}} is-selected{{/if}}">
    <div class="cartographer-parallax-layer-header">
        <button type="button" class="cartographer-parallax-button cartographer-parallax-collapse" data-action="toggle-tile-collapse" data-tile-id="{{id}}"
            data-tooltip="{{localize (ifThen collapsed "coffee-pub-cartographer.parallax.expand" "coffee-pub-cartographer.parallax.collapse")}}"><i class="fa-solid {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
        <button type="button" class="cartographer-parallax-thumb" data-action="select-tile" data-tile-id="{{id}}"
            data-tooltip="{{localize "coffee-pub-cartographer.parallax.selectTile"}}">
            {{#if isVideo}}<i class="fa-solid fa-film"></i>{{else}}<img src="{{src}}" alt="">{{/if}}
        </button>
        <div class="cartographer-parallax-layer-title">
            <span class="cartographer-parallax-layer-name" data-tooltip="{{src}}">{{name}}{{#each setNames}} <span class="cartographer-parallax-set-badge">{{this}}</span>{{/each}}</span>
            {{#if collapsed}}<span class="cartographer-parallax-layer-summary">{{summary}}</span>{{/if}}
        </div>
        <div class="cartographer-parallax-layer-actions">
            <button type="button" class="cartographer-parallax-button{{#if visible}} is-active{{/if}}" data-action="toggle-tile-visible" data-tile-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleTileVisible"}}"><i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
            <button type="button" class="cartographer-parallax-button is-danger" data-action="clear-tile-motion" data-tile-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.clearTileMotion"}}"><i class="fa-solid fa-trash-can"></i></button>
        </div>
    </div>

    {{#unless collapsed}}
    <label class="cartographer-parallax-field" data-tooltip="{{localize "coffee-pub-cartographer.parallax.tileOpacityHint"}}">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.opacity"}}</span>
        <input type="range" data-field="tileAlpha" data-tile-id="{{id}}" value="{{alpha}}"
            min="{{@root.ranges.alpha.min}}" max="{{@root.ranges.alpha.max}}" step="{{@root.ranges.alpha.step}}">
        <span class="cartographer-parallax-value">{{alpha}}</span>
    </label>

    <div class="cartographer-parallax-tile-part">
        {{> tilePartSwitch label=(localize "coffee-pub-cartographer.parallax.rotate") icon="fa-solid fa-rotate" tileId=id part="rotate" enabled=rotate.enabled}}
        {{#if rotate.enabled}}
        {{> tileSlider label=(localize "coffee-pub-cartographer.parallax.speed") tileId=id path="rotate.speed" value=rotate.speed range=@root.ranges.rotateSpeed zero=true readout=(concat rotate.speed "°/s")}}
        <div class="cartographer-parallax-field cartographer-parallax-start" data-tooltip="{{localize "coffee-pub-cartographer.parallax.pivotHint"}}">
            <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.pivot"}}</span>
            <div class="cartographer-parallax-xy">
                <label><span>X</span><input type="number" data-field="tile" data-tile-id="{{id}}" data-path="rotate.pivotX" value="{{rotate.pivotX}}"
                    min="{{@root.ranges.pivot.min}}" max="{{@root.ranges.pivot.max}}" step="{{@root.ranges.pivot.step}}"></label>
                <label><span>Y</span><input type="number" data-field="tile" data-tile-id="{{id}}" data-path="rotate.pivotY" value="{{rotate.pivotY}}"
                    min="{{@root.ranges.pivot.min}}" max="{{@root.ranges.pivot.max}}" step="{{@root.ranges.pivot.step}}"></label>
            </div>
        </div>
        {{/if}}
    </div>

    <div class="cartographer-parallax-tile-part">
        {{> tilePartSwitch label=(localize "coffee-pub-cartographer.parallax.scroll") icon="fa-solid fa-arrows-left-right" tileId=id part="scroll" enabled=scroll.enabled}}
        {{#if scroll.enabled}}
        {{> tileSlider label=(localize "coffee-pub-cartographer.parallax.speed") tileId=id path="scroll.speed" value=scroll.speed range=@root.ranges.scrollSpeed zero=true readout=scroll.speed}}
        {{> tileSlider label=(localize "coffee-pub-cartographer.parallax.angle") tileId=id path="scroll.angle" value=scroll.angle range=@root.ranges.scrollAngle readout=(concat scroll.angle "°")}}
        {{> tileSlider label=(localize "coffee-pub-cartographer.parallax.scale") tileId=id path="scroll.scale" value=scroll.scale range=@root.ranges.scrollScale readout=scroll.scale}}
        {{/if}}
    </div>
    {{/unless}}
</div>
{{/inline}}

{{! ===== GROUPS: the current mode's groups -- of layers, or of tiles ===== }}
{{#*inline "setsPanel"}}
<div class="cartographer-parallax-panel">
    <p class="cartographer-parallax-hint">{{groupsHint}}</p>
    <div class="cartographer-parallax-set-list">
        <div class="cartographer-parallax-set-row is-common{{#if allActive}} is-active{{/if}}">
            <button type="button" class="cartographer-parallax-button{{#if allActive}} is-active{{/if}}" data-action="select-set" data-set-id=""
                data-tooltip="{{allHint}}"><i class="fa-solid {{#if allActive}}fa-circle-dot{{else}}fa-circle{{/if}}"></i></button>
            <span class="cartographer-parallax-set-name">{{allLabel}}</span>
            <span class="cartographer-parallax-set-count">{{itemTotal}}</span>
        </div>
        <div class="cartographer-parallax-set-row is-common{{#if noneActive}} is-active{{/if}}">
            <button type="button" class="cartographer-parallax-button{{#if noneActive}} is-active{{/if}}" data-action="select-set" data-set-id="{{noneId}}"
                data-tooltip="{{noneHint}}"><i class="fa-solid {{#if noneActive}}fa-circle-dot{{else}}fa-circle{{/if}}"></i></button>
            <span class="cartographer-parallax-set-name">{{noneLabel}}</span>
            <span class="cartographer-parallax-set-count">0</span>
        </div>
        {{#each sets}}
        <div class="cartographer-parallax-set{{#if active}} is-active{{/if}}{{#if expanded}} is-expanded{{/if}}">
            <div class="cartographer-parallax-set-row{{#if active}} is-active{{/if}}">
                <button type="button" class="cartographer-parallax-button cartographer-parallax-collapse" data-action="toggle-set-expand" data-set-id="{{id}}"
                    data-tooltip="{{localize (ifThen expanded "coffee-pub-cartographer.parallax.collapse" "coffee-pub-cartographer.parallax.expand")}}"><i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></button>
                <button type="button" class="cartographer-parallax-button{{#if active}} is-active{{/if}}" data-action="toggle-group" data-set-id="{{id}}"
                    data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleGroup"}}"><i class="fa-solid {{#if active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></button>
                <span class="cartographer-parallax-set-name">{{name}}</span>
                <span class="cartographer-parallax-set-count">{{itemCount}}</span>
                <button type="button" class="cartographer-parallax-button" data-action="edit-set" data-set-id="{{id}}"
                    data-tooltip="{{localize "coffee-pub-cartographer.parallax.editSet"}}"><i class="fa-solid fa-pen"></i></button>
                <button type="button" class="cartographer-parallax-button is-danger" data-action="remove-set" data-set-id="{{id}}"
                    data-tooltip="{{localize "coffee-pub-cartographer.parallax.removeSet"}}"><i class="fa-solid fa-trash-can"></i></button>
            </div>
            {{#if expanded}}
            {{! The group's layers or tiles, each with its own on/off in this group.
                Off keeps it in the group; edit the group to take it out. }}
            <div class="cartographer-parallax-set-members">
                {{#each overheadMembers}}{{> setMember}}{{/each}}
                {{#if overheadMembers.length}}{{#if groundMembers.length}}{{> tokenLine}}{{/if}}{{/if}}
                {{#each groundMembers}}{{> setMember}}{{/each}}
                {{#each tileMembers}}{{> setTileMember}}{{/each}}
                {{#unless itemCount}}<div class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.parallax.setEmpty"}}</div>{{/unless}}
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>
    <div class="cartographer-parallax-panel-actions">
        <button type="button" class="cartographer-parallax-button is-labelled" data-action="add-set"><i class="fa-solid fa-plus"></i><span>{{localize "coffee-pub-cartographer.parallax.addSet"}}</span></button>
    </div>
</div>
{{/inline}}

{{! ===== COLLECTIONS: the whole scene's look, both modes at once ===== }}
{{#*inline "groupChips"}}
<div class="cartographer-parallax-chips">
    <button type="button" class="cartographer-parallax-chip{{#if all}} is-active{{/if}}" data-action="{{allAction}}">{{allLabel}}</button>
    <button type="button" class="cartographer-parallax-chip{{#if none}} is-active{{/if}}" data-action="{{noneAction}}">{{noneLabel}}</button>
    {{#each groups}}
    <button type="button" class="cartographer-parallax-chip is-toggle{{#if on}} is-active{{/if}}" data-action="{{../toggleAction}}" data-set-id="{{id}}">
        <i class="fa-solid {{#if on}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i> {{name}}
    </button>
    {{/each}}
</div>
{{/inline}}

{{#*inline "collectionsPanel"}}
<div class="cartographer-parallax-panel">
    <p class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.parallax.collectionsHint"}}</p>

    {{! The look right now: every group of both modes, on or off. Groups add together. }}
    <div class="cartographer-parallax-section-header">
        <i class="fa-solid fa-layer-group"></i><span>{{localize "coffee-pub-cartographer.parallax.layerGroups"}}</span>
    </div>
    {{#if collections.hasLayers}}
    {{> groupChips all=collections.layerAll none=collections.layerNone groups=collections.layerGroups
        allAction="layer-groups-all" noneAction="layer-groups-none" toggleAction="toggle-layer-group"
        allLabel=(localize "coffee-pub-cartographer.parallax.allLayers") noneLabel=(localize "coffee-pub-cartographer.parallax.noLayers")}}
    {{else}}
    <div class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.parallax.collectionsNoLayers"}}</div>
    {{/if}}

    <div class="cartographer-parallax-section-header">
        <i class="fa-solid fa-arrows-spin"></i><span>{{localize "coffee-pub-cartographer.parallax.tileGroups"}}</span>
    </div>
    {{#if collections.hasTiles}}
    {{> groupChips all=collections.tileAll none=collections.tileNone groups=collections.tileGroups
        allAction="tile-groups-all" noneAction="tile-groups-none" toggleAction="toggle-tile-group"
        allLabel=(localize "coffee-pub-cartographer.parallax.allTiles") noneLabel=(localize "coffee-pub-cartographer.parallax.noTiles")}}
    {{else}}
    <div class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.parallax.collectionsNoTiles"}}</div>
    {{/if}}

    {{! The saved looks. Current is whichever matches what is on now. }}
    <div class="cartographer-parallax-section-header">
        <i class="fa-solid fa-boxes-stacked"></i><span>{{localize "coffee-pub-cartographer.parallax.tabCollections"}}</span>
    </div>
    {{#if collections.hasCollections}}
    <div class="cartographer-parallax-set-list">
        {{#each collections.collections}}
        <div class="cartographer-parallax-set-row{{#if current}} is-active{{/if}}">
            <button type="button" class="cartographer-parallax-button{{#if current}} is-active{{/if}}" data-action="apply-collection" data-collection-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.applyCollection"}}"><i class="fa-solid {{#if current}}fa-circle-dot{{else}}fa-circle{{/if}}"></i></button>
            <div class="cartographer-parallax-layer-title">
                <span class="cartographer-parallax-set-name">{{name}}</span>
                <span class="cartographer-parallax-layer-summary">{{summary}}</span>
            </div>
            <button type="button" class="cartographer-parallax-button" data-action="update-collection" data-collection-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.updateCollection"}}"><i class="fa-solid fa-floppy-disk"></i></button>
            <button type="button" class="cartographer-parallax-button" data-action="rename-collection" data-collection-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.renameCollection"}}"><i class="fa-solid fa-pen"></i></button>
            <button type="button" class="cartographer-parallax-button is-danger" data-action="remove-collection" data-collection-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.removeCollection"}}"><i class="fa-solid fa-trash-can"></i></button>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.parallax.noCollections"}}</div>
    {{/if}}
    <div class="cartographer-parallax-panel-actions">
        <button type="button" class="cartographer-parallax-button is-labelled" data-action="save-collection"><i class="fa-solid fa-plus"></i><span>{{localize "coffee-pub-cartographer.parallax.saveCollection"}}</span></button>
    </div>
</div>
{{/inline}}

<div class="cartographer-parallax-root">
    {{#unless hasScene}}
    <div class="cartographer-parallax-empty">{{localize "coffee-pub-cartographer.parallax.noScene"}}</div>
    {{else}}

    {{#if isCollections}}
    {{! Collections mode: one panel, no tabs. }}
    {{> collectionsPanel}}
    {{else}}

    {{! The settings, as tabs. Running the scene is the control bar's job. }}
    <nav class="cartographer-parallax-tabs" role="tablist">
        {{#each tabs}}
        <button type="button" role="tab" class="cartographer-parallax-tab{{#if active}} is-active{{/if}}" data-action="set-tab" data-tab="{{id}}" aria-selected="{{active}}">
            <i class="{{icon}}"></i><span>{{label}}</span>{{#if count}}<span class="cartographer-parallax-tab-count">{{count}}</span>{{/if}}
        </button>
        {{/each}}
    </nav>

    {{#if isTiles}}

    {{#if (eq tab "movement")}}
    <div class="cartographer-parallax-panel">
        <label class="cartographer-parallax-field" data-tooltip="{{localize "coffee-pub-cartographer.parallax.easeHint"}}">
            <span class="cartographer-parallax-label"><i class="fa-solid fa-wave-square"></i> {{localize "coffee-pub-cartographer.parallax.ease"}}</span>
            <input type="range" data-field="tileEaseSeconds" value="{{tiles.motion.easeSeconds}}"
                min="{{ranges.easeSeconds.min}}" max="{{ranges.easeSeconds.max}}" step="{{ranges.easeSeconds.step}}">
            <span class="cartographer-parallax-value">{{tiles.motion.easeSeconds}}s</span>
        </label>
        <div class="cartographer-parallax-panel-actions">
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="reset-tile-positions"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.resetTilesHint"}}"><i class="fa-solid fa-rotate-left"></i><span>{{localize "coffee-pub-cartographer.parallax.resetPositions"}}</span></button>
        </div>
    </div>
    {{/if}}

    {{#if (eq tab "tiles")}}
    <div class="cartographer-parallax-panel">
        {{#if noneShowing}}<div class="cartographer-parallax-notice"><i class="fa-solid fa-eye-slash"></i> {{noneShowing}}</div>{{/if}}
        {{#if tiles.selectedUnmanaged}}
        {{! A tile is selected on the canvas that Cartographer does not manage yet. }}
        <button type="button" class="cartographer-parallax-add-tile" data-action="manage-selected-tile" data-tile-id="{{tiles.selectedUnmanaged.id}}">
            <i class="fa-solid fa-plus"></i> {{localize "coffee-pub-cartographer.parallax.manageSelectedTile"}} <strong>{{tiles.selectedUnmanaged.name}}</strong>
        </button>
        {{/if}}
        {{#if tiles.hasManaged}}
        <div class="cartographer-parallax-layers">
            {{#each tiles.managed}}{{> tileRow}}{{/each}}
        </div>
        {{else}}
        <div class="cartographer-parallax-empty">{{localize "coffee-pub-cartographer.parallax.selectATile"}}</div>
        {{/if}}
        {{#if tiles.hasManaged}}
        <div class="cartographer-parallax-panel-actions">
            <button type="button" class="cartographer-parallax-button" data-action="{{#if tiles.allCollapsed}}expand-all-tiles{{else}}collapse-all-tiles{{/if}}"
                data-tooltip="{{localize (ifThen tiles.allCollapsed "coffee-pub-cartographer.parallax.expandAll" "coffee-pub-cartographer.parallax.collapseAll")}}"><i class="fa-solid {{#if tiles.allCollapsed}}fa-angles-down{{else}}fa-angles-up{{/if}}"></i></button>
        </div>
        {{/if}}
    </div>
    {{/if}}

    {{else}}

    {{#if (eq tab "movement")}}
    <div class="cartographer-parallax-panel">
        <div class="cartographer-parallax-group">
            <div class="cartographer-parallax-field cartographer-parallax-presets">
                <span class="cartographer-parallax-label"><i class="fa-solid fa-compass"></i> {{localize "coffee-pub-cartographer.parallax.direction"}}</span>
                <div class="cartographer-parallax-preset-buttons">
                    {{#each directions}}
                    <button type="button" class="cartographer-parallax-button{{#if active}} is-active{{/if}}" data-action="set-direction" data-direction="{{id}}"
                        data-tooltip="{{label}}" aria-label="{{label}}"><i class="{{icon}}"></i></button>
                    {{/each}}
                </div>
            </div>
            <label class="cartographer-parallax-field">
                <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.angle"}}</span>
                <input type="range" data-field="angle" value="{{state.angle}}"
                    min="{{ranges.angle.min}}" max="{{ranges.angle.max}}" step="{{ranges.angle.step}}">
                <span class="cartographer-parallax-value">{{state.angle}}°</span>
            </label>
            <label class="cartographer-parallax-field" data-tooltip="{{localize "coffee-pub-cartographer.parallax.easeHint"}}">
                <span class="cartographer-parallax-label"><i class="fa-solid fa-wave-square"></i> {{localize "coffee-pub-cartographer.parallax.ease"}}</span>
                <input type="range" data-field="easeSeconds" value="{{state.easeSeconds}}"
                    min="{{ranges.easeSeconds.min}}" max="{{ranges.easeSeconds.max}}" step="{{ranges.easeSeconds.step}}">
                <span class="cartographer-parallax-value">{{state.easeSeconds}}s</span>
            </label>
        </div>

        <div class="cartographer-parallax-panel-actions">
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="reset-positions"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.resetPositionsHint"}}"><i class="fa-solid fa-rotate-left"></i><span>{{localize "coffee-pub-cartographer.parallax.resetPositions"}}</span></button>
        </div>
    </div>
    {{/if}}

    {{#if (eq tab "layers")}}
    <div class="cartographer-parallax-panel">
        {{#if noneShowing}}<div class="cartographer-parallax-notice"><i class="fa-solid fa-eye-slash"></i> {{noneShowing}}</div>{{/if}}
        {{#if hasLayers}}
        <div class="cartographer-parallax-section-header">
            <i class="fa-solid fa-layer-group"></i>
            <span>{{localize "coffee-pub-cartographer.parallax.layersNearestFirst"}}</span>
        </div>
        <div class="cartographer-parallax-layers">
            {{! Overhead layers draw above tokens, so they are listed above the line. }}
            {{#each overheadLayers}}{{> layerRow}}{{/each}}
            {{> tokenLine}}
            {{#each groundLayers}}{{> layerRow}}{{/each}}
        </div>
        {{else}}
        <div class="cartographer-parallax-empty">{{localize "coffee-pub-cartographer.parallax.noLayers"}}</div>
        {{/if}}
        <div class="cartographer-parallax-panel-actions">
            {{#if hasLayers}}
            <button type="button" class="cartographer-parallax-button" data-action="{{#if allCollapsed}}expand-all{{else}}collapse-all{{/if}}"
                data-tooltip="{{localize (ifThen allCollapsed "coffee-pub-cartographer.parallax.expandAll" "coffee-pub-cartographer.parallax.collapseAll")}}"><i class="fa-solid {{#if allCollapsed}}fa-angles-down{{else}}fa-angles-up{{/if}}"></i></button>
            {{/if}}
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="add-layer"><i class="fa-solid fa-plus"></i><span>{{localize "coffee-pub-cartographer.parallax.addLayer"}}</span></button>
        </div>
    </div>
    {{/if}}

    {{/if}}

    {{#if (eq tab "sets")}}{{> setsPanel}}{{/if}}
    {{/if}}

    {{/unless}}
</div>
