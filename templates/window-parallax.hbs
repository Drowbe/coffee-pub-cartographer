{{! Styled from the --blacksmith-tool-* variables so it follows Light, Dark and
    Glass. Sliders carry data-field (and data-layer-id for a layer); the window
    previews on input and writes the scene on change.

    Two modes share this template: setup, which builds the stack, and control,
    which keeps only what is needed while the scene is running. }}

{{! A layer in setup mode. Collapsed, it is one line: what it is, how fast,
    and the buttons. Expanded, its sliders follow. }}
{{#*inline "layerRow"}}
<div class="cartographer-parallax-layer{{#unless visible}} is-hidden{{/unless}}{{#if overhead}} is-overhead{{/if}}{{#if collapsed}} is-collapsed{{/if}}{{#if outOfSet}} is-out-of-set{{/if}}">
    <div class="cartographer-parallax-layer-header">
        <button type="button" class="cartographer-parallax-button cartographer-parallax-collapse" data-action="toggle-collapse" data-layer-id="{{id}}"
            data-tooltip="{{localize (ifThen collapsed "coffee-pub-cartographer.parallax.expand" "coffee-pub-cartographer.parallax.collapse")}}"><i class="fa-solid {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
        <button type="button" class="cartographer-parallax-thumb" data-action="replace-layer" data-layer-id="{{id}}"
            data-tooltip="{{localize "coffee-pub-cartographer.parallax.replaceImage"}}">
            {{#if isVideo}}<i class="fa-solid fa-film"></i>{{else}}<img src="{{src}}" alt="">{{/if}}
        </button>
        <div class="cartographer-parallax-layer-title">
            <span class="cartographer-parallax-layer-name" data-tooltip="{{src}}">{{name}}{{#if setName}} <span class="cartographer-parallax-set-badge">{{setName}}</span>{{/if}}</span>
            {{#if collapsed}}
            <span class="cartographer-parallax-layer-summary">
                {{speed}} px/s{{#if band}} · {{localize "coffee-pub-cartographer.parallax.band"}}{{/if}}{{#unless visible}} · {{localize "coffee-pub-cartographer.parallax.hidden"}}{{/unless}}
            </span>
            {{/if}}
        </div>
        <div class="cartographer-parallax-layer-actions">
            <button type="button" class="cartographer-parallax-button{{#if overhead}} is-active{{/if}}" data-action="toggle-overhead" data-layer-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleOverhead"}}"><i class="fa-solid fa-cloud"></i></button>
            <button type="button" class="cartographer-parallax-button{{#if visible}} is-active{{/if}}" data-action="toggle-visible" data-layer-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleVisible"}}"><i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
            <button type="button" class="cartographer-parallax-button" data-action="move-up" data-layer-id="{{id}}" {{#if isFirst}}disabled{{/if}}
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.moveNearer"}}"><i class="fa-solid fa-chevron-up"></i></button>
            <button type="button" class="cartographer-parallax-button" data-action="move-down" data-layer-id="{{id}}" {{#if isLast}}disabled{{/if}}
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.moveFarther"}}"><i class="fa-solid fa-chevron-down"></i></button>
            <button type="button" class="cartographer-parallax-button is-danger" data-action="remove-layer" data-layer-id="{{id}}"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.removeLayer"}}"><i class="fa-solid fa-trash-can"></i></button>
        </div>
    </div>

    {{#unless collapsed}}
    <label class="cartographer-parallax-field">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.speed"}}</span>
        <input type="range" data-field="speed" data-layer-id="{{id}}" value="{{speed}}"
            min="{{@root.ranges.speed.min}}" max="{{@root.ranges.speed.max}}" step="{{@root.ranges.speed.step}}">
        <span class="cartographer-parallax-value">{{speed}}</span>
    </label>
    <label class="cartographer-parallax-field">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.opacity"}}</span>
        <input type="range" data-field="alpha" data-layer-id="{{id}}" value="{{alpha}}"
            min="{{@root.ranges.alpha.min}}" max="{{@root.ranges.alpha.max}}" step="{{@root.ranges.alpha.step}}">
        <span class="cartographer-parallax-value">{{alpha}}</span>
    </label>
    <label class="cartographer-parallax-field">
        <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.scale"}}</span>
        <input type="range" data-field="scale" data-layer-id="{{id}}" value="{{scale}}"
            min="{{@root.ranges.scale.min}}" max="{{@root.ranges.scale.max}}" step="{{@root.ranges.scale.step}}">
        <span class="cartographer-parallax-value">{{scale}}</span>
    </label>
    {{#if @root.hasSets}}
    <label class="cartographer-parallax-field cartographer-parallax-set-field">
        <span class="cartographer-parallax-label" data-tooltip="{{localize "coffee-pub-cartographer.parallax.layerSetHint"}}">{{localize "coffee-pub-cartographer.parallax.layerSet"}}</span>
        <select data-field="set" data-layer-id="{{id}}">
            <option value="" {{#unless set}}selected{{/unless}}>{{localize "coffee-pub-cartographer.parallax.allSets"}}</option>
            {{#each setOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
    </label>
    {{/if}}
    <div class="cartographer-parallax-field cartographer-parallax-band">
        <label class="cartographer-parallax-label" data-tooltip="{{localize "coffee-pub-cartographer.parallax.bandHint"}}">
            <input type="checkbox" data-field="band" data-layer-id="{{id}}" {{checked band}}>
            {{localize "coffee-pub-cartographer.parallax.band"}}
        </label>
        {{#if band}}
        <label class="cartographer-parallax-band-offset" data-tooltip="{{localize "coffee-pub-cartographer.parallax.bandOffsetHint"}}">
            {{localize "coffee-pub-cartographer.parallax.bandOffset"}}
            <input type="number" data-field="bandOffset" data-layer-id="{{id}}" value="{{bandOffset}}" step="1">
        </label>
        {{/if}}
    </div>
    {{/unless}}
</div>
{{/inline}}

{{! A layer in control mode: its name and whether it is showing, nothing more. }}
{{#*inline "controlRow"}}
<div class="cartographer-parallax-control-row{{#unless visible}} is-hidden{{/unless}}">
    <span class="cartographer-parallax-layer-name" data-tooltip="{{src}}">{{name}}</span>
    <button type="button" class="cartographer-parallax-button{{#if visible}} is-active{{/if}}" data-action="toggle-visible" data-layer-id="{{id}}"
        data-tooltip="{{localize "coffee-pub-cartographer.parallax.toggleVisible"}}"><i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
</div>
{{/inline}}

{{#*inline "tokenLine"}}
<div class="cartographer-parallax-token-line" data-tooltip="{{localize "coffee-pub-cartographer.parallax.tokenLineHint"}}">
    <span><i class="fa-solid fa-chess-pawn"></i> {{localize "coffee-pub-cartographer.parallax.tokenLine"}}</span>
</div>
{{/inline}}

{{! The master speed track, shared by control mode and the Movement tab.
    Centred on zero: right runs forward, left runs in reverse, middle stops.
    The arrows at either end point the way the scenery will run on that side
    of zero, turned to the current angle. }}
{{#*inline "masterTrack"}}
<div class="cartographer-parallax-master-track">
    <i class="fa-solid fa-arrow-right cartographer-parallax-arrow" data-arrow="reverse" style="transform: rotate({{reverseAngle}}deg)"
        data-tooltip="{{localize "coffee-pub-cartographer.parallax.reverse"}}"></i>
    <label class="cartographer-parallax-field cartographer-parallax-master-slider">
        <input type="range" data-field="masterSpeed" value="{{state.masterSpeed}}" list="cartographer-parallax-zero"
            min="{{ranges.masterSpeed.min}}" max="{{ranges.masterSpeed.max}}" step="{{ranges.masterSpeed.step}}"
            aria-label="{{localize "coffee-pub-cartographer.parallax.masterSpeed"}}">
        <span class="cartographer-parallax-value" data-tooltip="{{localize "coffee-pub-cartographer.parallax.masterSpeed"}}">{{masterLabel}}</span>
    </label>
    <i class="fa-solid fa-arrow-right cartographer-parallax-arrow" data-arrow="forward" style="transform: rotate({{state.angle}}deg)"
        data-tooltip="{{localize "coffee-pub-cartographer.parallax.forward"}}"></i>
</div>
<datalist id="cartographer-parallax-zero"><option value="0"></option></datalist>
{{/inline}}

{{! Quick switch between sets, for control mode and the head of the Layers tab. }}
{{#*inline "setChips"}}
{{#if hasSets}}
<div class="cartographer-parallax-sets">
    <span class="cartographer-parallax-label"><i class="fa-solid fa-swatchbook"></i> {{localize "coffee-pub-cartographer.parallax.showing"}}</span>
    <div class="cartographer-parallax-set-chips">
        {{#each sets}}
        <button type="button" class="cartographer-parallax-set-chip{{#if active}} is-active{{/if}}" data-action="select-set" data-set-id="{{id}}">{{name}}</button>
        {{/each}}
    </div>
</div>
{{/if}}
{{/inline}}

<div class="cartographer-parallax-root{{#if isControl}} is-control{{/if}}">
    {{#unless hasScene}}
    <div class="cartographer-parallax-empty">{{localize "coffee-pub-cartographer.parallax.noScene"}}</div>
    {{else}}

    {{#if isControl}}
    {{! ===== CONTROL: only what is needed while the scene runs ===== }}
    <div class="cartographer-parallax-master">{{> masterTrack}}</div>
    {{> setChips}}
    {{#if hasLayers}}
    <div class="cartographer-parallax-control-layers">
        {{#each overheadLayers}}{{> controlRow}}{{/each}}
        {{> tokenLine}}
        {{#each groundLayers}}{{> controlRow}}{{/each}}
    </div>
    {{else}}
    <div class="cartographer-parallax-empty">{{localize "coffee-pub-cartographer.parallax.noLayers"}}</div>
    {{/if}}

    {{else}}
    {{! ===== SETUP: three tabs ===== }}
    <nav class="cartographer-parallax-tabs" role="tablist">
        {{#each tabs}}
        <button type="button" role="tab" class="cartographer-parallax-tab{{#if active}} is-active{{/if}}" data-action="set-tab" data-tab="{{id}}" aria-selected="{{active}}">
            <i class="{{icon}}"></i><span>{{label}}</span>{{#if count}}<span class="cartographer-parallax-tab-count">{{count}}</span>{{/if}}
        </button>
        {{/each}}
    </nav>

    {{#if (eq tab "movement")}}
    <div class="cartographer-parallax-panel">
        <div class="cartographer-parallax-master">
            <span class="cartographer-parallax-label"><i class="fa-solid fa-gauge-high"></i> {{localize "coffee-pub-cartographer.parallax.masterSpeed"}}</span>
            {{> masterTrack}}
        </div>

        <div class="cartographer-parallax-group">
            <div class="cartographer-parallax-field cartographer-parallax-presets">
                <span class="cartographer-parallax-label"><i class="fa-solid fa-compass"></i> {{localize "coffee-pub-cartographer.parallax.direction"}}</span>
                <div class="cartographer-parallax-preset-buttons">
                    {{#each directions}}
                    <button type="button" class="cartographer-parallax-button{{#if active}} is-active{{/if}}" data-action="set-direction" data-direction="{{id}}"
                        data-tooltip="{{label}}" aria-label="{{label}}"><i class="{{icon}}"></i></button>
                    {{/each}}
                </div>
            </div>
            <label class="cartographer-parallax-field">
                <span class="cartographer-parallax-label">{{localize "coffee-pub-cartographer.parallax.angle"}}</span>
                <input type="range" data-field="angle" value="{{state.angle}}"
                    min="{{ranges.angle.min}}" max="{{ranges.angle.max}}" step="{{ranges.angle.step}}">
                <span class="cartographer-parallax-value">{{state.angle}}°</span>
            </label>
            <label class="cartographer-parallax-field" data-tooltip="{{localize "coffee-pub-cartographer.parallax.easeHint"}}">
                <span class="cartographer-parallax-label"><i class="fa-solid fa-wave-square"></i> {{localize "coffee-pub-cartographer.parallax.ease"}}</span>
                <input type="range" data-field="easeSeconds" value="{{state.easeSeconds}}"
                    min="{{ranges.easeSeconds.min}}" max="{{ranges.easeSeconds.max}}" step="{{ranges.easeSeconds.step}}">
                <span class="cartographer-parallax-value">{{state.easeSeconds}}s</span>
            </label>
        </div>

        <div class="cartographer-parallax-panel-actions">
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="reset-positions"
                data-tooltip="{{localize "coffee-pub-cartographer.parallax.resetPositionsHint"}}"><i class="fa-solid fa-rotate-left"></i><span>{{localize "coffee-pub-cartographer.parallax.resetPositions"}}</span></button>
        </div>
    </div>
    {{/if}}

    {{#if (eq tab "layers")}}
    <div class="cartographer-parallax-panel">
        {{> setChips}}
        {{#if hasLayers}}
        <div class="cartographer-parallax-section-header">
            <i class="fa-solid fa-layer-group"></i>
            <span>{{localize "coffee-pub-cartographer.parallax.layersNearestFirst"}}</span>
        </div>
        <div class="cartographer-parallax-layers">
            {{! Overhead layers draw above tokens, so they are listed above the line. }}
            {{#each overheadLayers}}{{> layerRow}}{{/each}}
            {{> tokenLine}}
            {{#each groundLayers}}{{> layerRow}}{{/each}}
        </div>
        {{else}}
        <div class="cartographer-parallax-empty">{{localize "coffee-pub-cartographer.parallax.noLayers"}}</div>
        {{/if}}
        <div class="cartographer-parallax-panel-actions">
            {{#if hasLayers}}
            <button type="button" class="cartographer-parallax-button" data-action="{{#if allCollapsed}}expand-all{{else}}collapse-all{{/if}}"
                data-tooltip="{{localize (ifThen allCollapsed "coffee-pub-cartographer.parallax.expandAll" "coffee-pub-cartographer.parallax.collapseAll")}}"><i class="fa-solid {{#if allCollapsed}}fa-angles-down{{else}}fa-angles-up{{/if}}"></i></button>
            {{/if}}
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="add-layer"><i class="fa-solid fa-plus"></i><span>{{localize "coffee-pub-cartographer.parallax.addLayer"}}</span></button>
        </div>
    </div>
    {{/if}}

    {{#if (eq tab "sets")}}
    <div class="cartographer-parallax-panel">
        <p class="cartographer-parallax-hint">{{localize "coffee-pub-cartographer.parallax.setsHint"}}</p>
        <div class="cartographer-parallax-set-list">
            {{#each sets}}
            <div class="cartographer-parallax-set-row{{#if active}} is-active{{/if}}">
                <button type="button" class="cartographer-parallax-button{{#if active}} is-active{{/if}}" data-action="select-set" data-set-id="{{id}}"
                    data-tooltip="{{localize "coffee-pub-cartographer.parallax.showSet"}}"><i class="fa-solid {{#if active}}fa-circle-dot{{else}}fa-circle{{/if}}"></i></button>
                <span class="cartographer-parallax-set-name">{{name}}</span>
                <span class="cartographer-parallax-set-count">{{layerCount}}</span>
                <button type="button" class="cartographer-parallax-button" data-action="rename-set" data-set-id="{{id}}"
                    data-tooltip="{{localize "coffee-pub-cartographer.parallax.renameSet"}}"><i class="fa-solid fa-pen"></i></button>
                <button type="button" class="cartographer-parallax-button is-danger" data-action="remove-set" data-set-id="{{id}}"
                    data-tooltip="{{localize "coffee-pub-cartographer.parallax.removeSet"}}"><i class="fa-solid fa-trash-can"></i></button>
            </div>
            {{/each}}
            <div class="cartographer-parallax-set-row is-common">
                <i class="fa-solid fa-layer-group cartographer-parallax-set-icon"></i>
                <span class="cartographer-parallax-set-name">{{localize "coffee-pub-cartographer.parallax.allSets"}}</span>
                <span class="cartographer-parallax-set-count">{{commonCount}}</span>
            </div>
        </div>
        <div class="cartographer-parallax-panel-actions">
            <button type="button" class="cartographer-parallax-button is-labelled" data-action="add-set"><i class="fa-solid fa-plus"></i><span>{{localize "coffee-pub-cartographer.parallax.addSet"}}</span></button>
        </div>
    </div>
    {{/if}}
    {{/if}}

    {{/unless}}
</div>
